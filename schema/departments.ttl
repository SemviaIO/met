# The nineteen curatorial departments of the Metropolitan Museum, as a SKOS
# scheme — the only file in this package that ships data rather than a way to
# read it.
#
# WHY THESE CONCEPTS DO NOT LIVE IN THIS PACKAGE'S NAMESPACE. Every other term
# here is `<ontology#…>`, because this package coins it. These nineteen are not
# coined here: they are the IRIs the Objects mapping mints from the `department`
# column, and they have to be character-for-character what that template
# produces or the department edge points at a subject nothing describes. A join
# through a department would then return no rows and no error — the worst
# failure shape this package can have. Their namespace is the source's because
# their identity is the source's.
#
# WHY THE PERCENT-ENCODING IS LOAD-BEARING. Template minting runs the cell
# through `iri_safe_encode`, which leaves RFC 3987 `iunreserved` alone and
# percent-encodes everything else as UPPERCASE hex. A space is `%20` and a comma
# is `%2C` — `%2c` is a different IRI and would silently break the one department
# whose name contains a comma. That encoding is also a strict left inverse, which
# is what lets a ground department IRI in a query push down to a SQL equality on
# the raw column instead of fetching the table and filtering in memory.
#
# WHY PLAIN LITERALS AND NOT `@en`. The labels are proper nouns — the names of
# real organisational units, not English renderings of a concept that has other
# renderings. House rule: proper nouns are `xsd:string`.
#
# THE COUNTS ARE A DRIFT DETECTOR. Each `skos:scopeNote` carries the row count
# measured against `public.objects` on 2026-08-29, and the nineteen sum to
# exactly 484,956 — the table's full row count, with no nulls and no twentieth
# value. If that stops holding, the source has changed shape and the corpus
# oracles are stale.

@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix svs:  <https://pkg.semvia.io/semvia/core/meta-schema#> .
@prefix svds: <https://pkg.semvia.io/semvia/core/dataset#> .
@prefix met:  <ontology#> .
@prefix dept: <#> .

<> a svs:Schema ;
  dct:title "Met Museum Departments"@en ;
  dct:description "The nineteen curatorial departments of the Metropolitan Museum as a SKOS concept scheme. The concept IRIs are the ones the Objects mapping mints from the department column, so this file is what gives a department edge something to resolve to."@en ;
  # Absolute IRIs for what this package does not own; a relative `<../…>` would
  # resolve against this package's baseIRI and land on an IRI nothing publishes.
  svds:imports <https://pkg.semvia.io/semvia/core/meta-schema> ;
  svds:imports <./ontology> ;
  sh:declare [
    a sh:PrefixDeclaration ;
    sh:prefix "dept" ;
    sh:namespace dept:
  ] ;
.

################################################################
# The scheme
################################################################

# The scheme is this package's own construct, so it keeps this package's
# namespace even though every concept in it does not.
dept:scheme a skos:ConceptScheme ;
  rdfs:label "Met Museum curatorial departments"@en ;
  rdfs:comment "Closed at nineteen. The department column is non-null on every row and takes no other value."@en ;
.

################################################################
# The concepts
################################################################

<https://data.metmuseum.org/department/Ancient%20Near%20Eastern%20Art>
  a skos:Concept, met:Department ;
  skos:prefLabel "Ancient Near Eastern Art" ;
  skos:inScheme dept:scheme ;
  skos:scopeNote "6,223 rows."@en ;
.

